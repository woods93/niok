---
layout: base.njk
title: Family
permalink: /family/
---
<h1>Family</h1>
<p class="lede">Pictures of and links to our partners and friends.</p>

{% if family and family.length %}
<div class="fam-grid">
  {% for f in family %}
  <article class="card fam">
    {% if f.image %}<a class="fam-pic" href="{{ f.url }}" rel="noopener"><img src="{{ f.image }}" alt="{{ f.name }}" loading="lazy" referrerpolicy="no-referrer" onerror="this.parentNode.remove()"></a>{% endif %}
    <h3 class="card-title"><a href="{{ f.url }}" rel="noopener">{{ f.name }}</a></h3>
    {% if f.blurb %}<p>{{ f.blurb }}</p>{% endif %}
  </article>
  {% endfor %}
</div>
{% else %}
<p class="empty">Nothing here yet. Check back soon.</p>
{% endif %}

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}: host picks" href="{{ '/feed.xml' | url }}">
</head>
<body>
  <header class="masthead">
    <a class="banner" href="{{ '/' | url }}" aria-label="{{ site.title }}: home"><img src="https://yt3.googleusercontent.com/Jtw1y0iBRC5QylOyydC-MrKEry-a9yKyZxMT-O71DsmyoTzSlqjVf0OYmpDivaOnBOdh758Baw=w1707-fcrop64=1,00005a57ffffa5a8-k-c0xffffffff-no-nd-rj" alt="The Nashville I Once Knew, with Laurie Webb" referrerpolicy="no-referrer" onerror="this.replaceWith(document.createTextNode('{{ site.title }}'))"></a>
    <nav aria-label="Main">
      <a href="{{ '/' | url }}">Episodes</a>
      <a href="{{ '/news/' | url }}">Latest News</a>
      <a href="{{ '/picks/' | url }}">Host picks</a>
      <a href="{{ '/archive/' | url }}">Archive</a>
      <a href="{{ '/search/' | url }}">Search</a>
      <a href="{{ '/family/' | url }}">Family</a>
      <a href="{{ '/about/' | url }}">About</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <p>Headlines and short excerpts link to the original publishers. All rights in the stories belong to their sources.</p>
    <p><a href="{{ '/feed.xml' | url }}">Host picks RSS</a> · <a href="{{ '/status/' | url }}">Source status</a> · <a href="{{ '/about/' | url }}">About and takedowns</a></p>
  </footer>
  {% if script %}<script src="{{ ('/assets/' + script) | url }}" defer></script>{% endif %}
</body>
</html>
